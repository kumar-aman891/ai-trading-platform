# AI Trading Platform — environment template
#
# Copy to `.env` for local development. `.env` is gitignored and must never be
# committed. Every value below is a placeholder — replace locally, never here.
#
# Phase 1 scope only. Do NOT add broker (KITE_*), LLM provider, or market-data
# provider credentials to this file or to `.env`. atp_platform.config refuses
# to start the process if any such variable is present (see ADR-006 and
# security/SECRET_HANDLING.md) — Phase 1 has no legitimate use for one.

# --- Runtime -------------------------------------------------------------
ENVIRONMENT=development
TRADING_MODE=PAPER
# TRADING_MODE must be PAPER in this build. LIVE is rejected at startup —
# the LIVE execution path does not exist yet (see ADR-005).

# --- Database (per-service role — see ops/sql/roles_and_schemas.sql.tmpl) --
# `docker compose up` (docker-compose.yml) creates the atp_owner/atp_api/
# atp_paper_exec/atp_worker roles using the ATP_*_PASSWORD values below - see
# ops/sql/01_bootstrap_roles.sh. Each service (api, paper-exec, worker) is
# meant to run with its own DSN below, built from its own least-privilege
# role; no application role may ever have superuser or a LIVE-schema grant
# (ADR-005). DATABASE_URL is the migration/owner DSN, used by the migration
# step (Step 6+) and by local dev tooling - application services never use
# the owner role.
POSTGRES_DB=atp
POSTGRES_BOOTSTRAP_USER=postgres
POSTGRES_BOOTSTRAP_PASSWORD=replace-with-a-generated-secret
ATP_OWNER_PASSWORD=replace-with-a-generated-secret
ATP_API_PASSWORD=replace-with-a-generated-secret
ATP_PAPER_EXEC_PASSWORD=replace-with-a-generated-secret
ATP_WORKER_PASSWORD=replace-with-a-generated-secret
ATP_STRATEGY_PASSWORD=replace-with-a-generated-secret

DATABASE_URL=postgresql+psycopg://atp_owner:replace-with-a-generated-secret@localhost:5432/atp
# Per-service DSNs (Step 6+ services read one of these, never DATABASE_URL):
# ATP_API_DATABASE_URL=postgresql+psycopg://atp_api:replace-with-a-generated-secret@localhost:5432/atp
# ATP_PAPER_EXEC_DATABASE_URL=postgresql+psycopg://atp_paper_exec:replace-with-a-generated-secret@localhost:5432/atp
# ATP_WORKER_DATABASE_URL=postgresql+psycopg://atp_worker:replace-with-a-generated-secret@localhost:5432/atp
# ATP_STRATEGY_DATABASE_URL=postgresql+psycopg://atp_strategy:replace-with-a-generated-secret@localhost:5432/atp

# --- Redis -----------------------------------------------------------------
# Redis always requires authentication (Step 5) - atp_platform.config
# refuses to start with an unauthenticated REDIS_URL.
REDIS_PASSWORD=replace-with-a-generated-secret
REDIS_URL=redis://:replace-with-a-generated-secret@localhost:6379/0

# --- Session / auth --------------------------------------------------------
# 32+ random bytes. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=replace-with-a-generated-32-byte-minimum-secret
SESSION_TTL_SECONDS=28800

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- API (CORS / rate limiting / bootstrap) --------------------------------
# CORS_ALLOWED_ORIGINS=https://app.example.local
# CORS_ALLOW_CREDENTIALS=false
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=60
# LOGIN_RATE_LIMIT_REQUESTS=5
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
#
# BOOTSTRAP_ADMIN_TOKEN gates `python -m atp_api.bootstrap` (Step 8) - set it
# only for the duration of that one run, then unset/rotate it. It is never
# read by the running API service itself outside that script. Bootstrap also
# refuses unconditionally once core.users has any row, regardless of this
# value, so leaving a stale value here after the first successful bootstrap
# is not a way back in.
# BOOTSTRAP_ADMIN_TOKEN=replace-with-a-generated-one-time-secret
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=

# --- Explicitly NOT permitted in Phase 1 (documented, never set) -----------
# KITE_API_KEY=
# KITE_API_SECRET=
# KITE_ACCESS_TOKEN=
# LLM_PROVIDER=
# LLM_API_KEY=
