# Normalize line endings; diffs stay stable across Windows/Linux contributors.
* text=auto eol=lf

*.py  text eol=lf
*.md  text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.sh  text eol=lf
*.sql text eol=lf

*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary — never diff or normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.pdf  binary
