# Placeholder credentials for the ephemeral integration-test stack
# (docker-compose.test.yml) only. Mirrors the pattern in the root
# .env.example (security/SECRET_HANDLING.md): committed values here are
# fixture-only, never real, and the stack they configure is destroyed
# (tmpfs data directory, `docker compose down`) after every test run.
#
# Copy to ops/docker/test.env for local use, or let `make test-integration`
# pass this file straight to `docker compose --env-file`. Never point these
# variables at a real database - TEST_DATABASE_URL/TEST_REDIS_URL are wired
# to the ephemeral `postgres`/`redis` services defined in
# docker-compose.test.yml only.

POSTGRES_DB=atp_test
POSTGRES_BOOTSTRAP_USER=postgres
POSTGRES_BOOTSTRAP_PASSWORD=test-fixture-not-a-secret
ATP_OWNER_PASSWORD=test-fixture-owner-not-a-secret
ATP_API_PASSWORD=test-fixture-api-not-a-secret
ATP_PAPER_EXEC_PASSWORD=test-fixture-paper-exec-not-a-secret
ATP_WORKER_PASSWORD=test-fixture-worker-not-a-secret
ATP_STRATEGY_PASSWORD=test-fixture-strategy-not-a-secret
REDIS_PASSWORD=test-fixture-redis-not-a-secret

TEST_DATABASE_URL=postgresql://atp_owner:test-fixture-owner-not-a-secret@postgres:5432/atp_test
TEST_ATP_API_DSN=postgresql://atp_api:test-fixture-api-not-a-secret@postgres:5432/atp_test
TEST_ATP_PAPER_EXEC_DSN=postgresql://atp_paper_exec:test-fixture-paper-exec-not-a-secret@postgres:5432/atp_test
TEST_ATP_WORKER_DSN=postgresql://atp_worker:test-fixture-worker-not-a-secret@postgres:5432/atp_test
TEST_ATP_STRATEGY_DSN=postgresql://atp_strategy:test-fixture-strategy-not-a-secret@postgres:5432/atp_test
TEST_REDIS_URL=redis://:test-fixture-redis-not-a-secret@redis:6379/0
